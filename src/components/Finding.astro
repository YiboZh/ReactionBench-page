---
interface Props { number: string; title: string; color?: string }
const { number, title, color = "--rb-data" } = Astro.props;
---

<div class="not-prose rounded-xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900" style={`border-top: 4px solid var(${color})`}>
  <div class="text-4xl leading-none font-bold tabular-nums" style={`color: var(${color})`}>{number}</div>
  <div class="mt-3 text-lg font-semibold text-zinc-900 dark:text-zinc-50">{title}</div>
  <div class="mt-1 text-[0.95rem] leading-relaxed text-zinc-700 dark:text-zinc-300"><slot /></div>
</div>
